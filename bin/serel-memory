#!/usr/bin/env bash
# Serel Memory CLI — READ-ONLY.
#
# Usage:
#   bin/serel-memory check [--scope <path>] [--root <repo_root>]
#
# `check` is the deterministic drift checker. It compares the effective memory
# bank against what this repository can prove offline: the anchor parses, the
# bank exists and is initialized, retention targets are met, and every evidence
# marker a bank line declares still matches the repo at HEAD. It never writes,
# never fetches, and never judges whether a claim is *true* — only whether the
# evidence it declares still holds. Contract: docs/workflow-contract.md
# "Drift check".
#
# Output: one `<KIND> <location> <message>` line per finding
# (KIND = DRIFT | STALE | INCOMPLETE | WARN | INFO), then one summary line.
#
# Exit: 0 clean; 1 drift or stale; 2 an assessment could not finish (any
# INCOMPLETE, or a structural failure such as a missing helper).
set -euo pipefail

SELF="serel-memory"

# The sync-upstream framework allowlist (see .claude/commands/sync-upstream.md).
# Baseline comparison is bounded to these paths: everything else in a repo is
# the user's own project.
FRAMEWORK_PATHS=(.agents/skills/ .claude/commands/ AGENTS.md CLAUDE.md \
  docs/workflow-contract.md docs/cross-agent-review.md hooks/ bin/serel-memory)

CORE_FILES=(projectbrief productContext systemPatterns techContext decisionLog activeContext progress)

n_drift=0; n_stale=0; n_incomplete=0; n_warn=0; n_fresh=0; n_unmarked=0
baseline_label="unavailable"

usage() {
  cat <<'USAGE'
usage: serel-memory check [--scope <path>] [--root <repo_root>]

  check   Read-only drift check over the effective memory bank.
          Exit 0 clean, 1 drift or stale findings, 2 could not finish.
USAGE
}

die() { echo "$SELF: $*" >&2; exit 2; }

finding() { # KIND location message
  printf '%s %s %s\n' "$1" "$2" "$3"
  case "$1" in
    DRIFT)      n_drift=$((n_drift + 1)) ;;
    STALE)      n_stale=$((n_stale + 1)) ;;
    INCOMPLETE) n_incomplete=$((n_incomplete + 1)) ;;
    WARN)       n_warn=$((n_warn + 1)) ;;
  esac
}

finish() {
  local code=0
  if [ "$n_drift" -gt 0 ] || [ "$n_stale" -gt 0 ]; then code=1; fi
  if [ "$n_incomplete" -gt 0 ]; then code=2; fi
  printf '%s check: %d drift, %d stale, %d incomplete, %d warn, %d fresh, %d unmarked, baseline: %s — exit %d\n' \
    "$SELF" "$n_drift" "$n_stale" "$n_incomplete" "$n_warn" "$n_fresh" "$n_unmarked" "$baseline_label" "$code"
  exit "$code"
}

# --- Template-only detection --------------------------------------------------
# A core bank file is "uninitialized" when it carries no content line: every
# line is blank, a heading, blockquote guidance, an HTML comment, a fence
# delimiter, or an empty placeholder (a bare list marker, an empty task box, a
# label with no value, a bracketed [placeholder]). Conservative by design — a
# single real line makes the file initialized. Prints "TEMPLATE" or "CONTENT".
#
# KNOWN-PLACEHOLDER: shipped template lines that are indistinguishable from
# real content by shape alone (an env-var example reads exactly like a real
# entry). tests/smoke-check.sh asserts all seven shipped templates still
# classify as TEMPLATE, so this list cannot rot silently.
classify_file() {
  awk '
    BEGIN { incomment = 0; content = 0 }
    {
      out = ""; s = $0
      do {
        if (incomment) {
          e = index(s, "-->")
          if (e == 0) { s = "" } else { s = substr(s, e + 3); incomment = 0 }
        } else {
          b = index(s, "<!--")
          if (b == 0) { out = out s; s = "" }
          else { out = out substr(s, 1, b - 1); s = substr(s, b + 4); incomment = 1 }
        }
      } while (s != "")
      line = out
      gsub(/^[ \t]+/, "", line); gsub(/[ \t]+$/, "", line)
      if (line == "") next
      if (line == "- `VAR_NAME` — what it does") next          # KNOWN-PLACEHOLDER
      if (substr(line, 1, 1) == "#") next                       # heading
      if (substr(line, 1, 1) == ">") next                       # blockquote guidance
      if (line ~ /^(```|~~~)/) next                             # fence delimiter
      sub(/^([-*+]|[0-9]+\.)[ \t]*/, "", line)                  # list marker
      sub(/^\[[ xX]\][ \t]*/, "", line)                         # task box
      if (line == "") next
      if (line ~ /\[[^]]*\][^(]/ || line ~ /\[[^]]*\]$/) next   # [placeholder], not a link
      t = line
      gsub(/[*_`]/, "", t)
      gsub(/[ \t]+$/, "", t)
      if (t == "") next
      if (t ~ /:$/) next                                        # label with no value
      content = 1
    }
    END { print (content ? "CONTENT" : "TEMPLATE") }
  ' "$1"
}

# --- check --------------------------------------------------------------------
cmd_check() {
  local scope="" root=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --scope) scope="${2:-}"; shift 2 ;;
      --root)  root="${2:-}"; shift 2 ;;
      *) usage >&2; die "unknown argument '$1'" ;;
    esac
  done

  if ! command -v git >/dev/null 2>&1; then
    finding INCOMPLETE repo "git is required: the checker compares the bank against the repository"
    finish
  fi
  if [ -z "$root" ]; then
    root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  fi
  if [ -z "$root" ] || [ ! -d "$root" ]; then
    finding INCOMPLETE repo "not a git repository (run inside one, or pass --root <repo_root>)"
    finish
  fi
  root="$(cd "$root" && pwd -P)"
  if ! command -v jq >/dev/null 2>&1; then
    finding INCOMPLETE repo "jq is required: the anchor and scopes cannot be read without it"
    finish
  fi

  local git_ok=1
  git -C "$root" rev-parse --verify --quiet HEAD >/dev/null 2>&1 || git_ok=0

  check_anchor "$root"
  resolve_scope "$root" "$scope" || finish
  check_bank "$root" "$BANK_DIR"
  check_retention "$root" "$BANK_DIR"
  check_markers "$root" "$SCOPE_ROOT" "$BANK_DIR" "$git_ok"
  check_unmarked "$root" "$BANK_DIR"
  check_baseline "$root" "$git_ok"
  finish
}

# 1. ANCHOR ---------------------------------------------------------------------
check_anchor() {
  local root="$1" t
  local anchor="$root/.serel-memory.json"
  if [ -f "$root/.basecamp.json" ]; then
    finding DRIFT ".basecamp.json" "legacy anchor: migrate — rename it to .serel-memory.json (same schema)"
  fi
  if [ ! -f "$anchor" ]; then
    finding INCOMPLETE ".serel-memory.json" "provenance anchor missing: nothing records which upstream version this project came from"
    return 0
  fi
  if ! jq -e . "$anchor" >/dev/null 2>&1; then
    finding INCOMPLETE ".serel-memory.json" "anchor does not parse as JSON"
    return 0
  fi
  for t in "upstream string" "ref string" "linked boolean"; do
    local key="${t% *}" want="${t#* }" got
    got="$(jq -r --arg k "$key" 'if has($k) then (.[$k] | type) else "absent" end' "$anchor")"
    if [ "$got" != "$want" ]; then
      finding INCOMPLETE ".serel-memory.json" "anchor key \"$key\" must be a $want (got $got)"
    fi
  done
}

# 2. BANK -----------------------------------------------------------------------
# Resolves the scope through the helper (subprocess, never sourced) and reports
# the helper's own warnings as INCOMPLETE: a degraded resolver means the bank
# under assessment may not be the one the workflows would target. Sets
# SCOPE_ROOT and BANK_DIR — no command substitution, so findings counted here
# survive (a subshell's counters would not).
SCOPE_ROOT="."
BANK_DIR="memory-bank"
resolve_scope() {
  local root="$1" scope="$2" err out line
  local helper="$root/hooks/lib/resolve-scope.sh"
  if [ ! -f "$helper" ]; then
    finding INCOMPLETE "hooks/lib/resolve-scope.sh" "scope resolver missing: cannot tell which bank this invocation targets"
    return 1
  fi
  err="$(bash "$helper" --root "$root" --list 2>&1 >/dev/null || true)"
  if [ -n "$err" ]; then
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      finding INCOMPLETE repo "scopes: ${line#resolve-scope: }"
    done <<<"$err"
  fi
  local args=(--root "$root" --cwd "$PWD")
  [ -n "$scope" ] && args+=(--scope "$scope")
  local errfile
  errfile="$(mktemp)"
  if ! out="$(bash "$helper" "${args[@]}" 2>"$errfile")"; then
    local msg
    msg="$(tr '\n' ' ' <"$errfile")"
    rm -f "$errfile"
    finding INCOMPLETE repo "scope not resolved: ${msg:-unknown scope}"
    return 1
  fi
  rm -f "$errfile"
  SCOPE_ROOT="$(printf '%s' "$out" | cut -f1)"
  BANK_DIR="$(printf '%s' "$out" | cut -f2)"
}

check_bank() {
  local root="$1" bank="$2" f overlay=0
  case "$bank" in *memory-bank.local) overlay=1 ;; esac
  if [ ! -d "$root/$bank" ]; then
    finding DRIFT "$bank" "bank directory missing: this scope has no memory bank yet"
    return 0
  fi
  for f in "${CORE_FILES[@]}"; do
    if [ ! -f "$root/$bank/$f.md" ]; then
      # The maintainer overlay is partial by design (contract: "Resolving the
      # effective bank") — intent for the files it lacks lives in README/docs.
      if [ "$overlay" -eq 1 ]; then
        finding INFO "$bank/$f.md" "overlay lacks $f.md (partial by design)"
      else
        finding DRIFT "$bank/$f.md" "missing bank file"
      fi
      continue
    fi
    if [ "$(classify_file "$root/$bank/$f.md")" = "TEMPLATE" ]; then
      finding DRIFT "$bank/$f.md" "uninitialized: $f.md still holds only template placeholders"
    fi
  done
}

# 3. RETENTION -------------------------------------------------------------------
# Soft targets (contract "Retention"): exceeding one is a WARN, never an error.
check_retention() {
  local root="$1" bank="$2" kind out result
  local helper="$root/hooks/lib/rotate-check.sh"
  if [ ! -f "$helper" ]; then
    finding INCOMPLETE "hooks/lib/rotate-check.sh" "retention helper missing: bank size not assessed"
    return 0
  fi
  for kind in activeContext progress; do
    [ -f "$root/$bank/$kind.md" ] || continue
    if ! out="$(bash "$helper" "$root/$bank/$kind.md" "$kind" 2>&1)"; then
      finding INCOMPLETE "$bank/$kind.md" "retention helper failed: $(printf '%s' "$out" | head -1)"
      continue
    fi
    if printf '%s\n' "$out" | grep -q '^UNSUPPORTED:'; then
      finding WARN "$bank/$kind.md" "retention cannot see part of $kind.md: $(printf '%s\n' "$out" | sed -n 's/^UNSUPPORTED: //p' | head -1)"
    fi
    result="$(printf '%s\n' "$out" | sed -n 's/^RESULT: //p' | head -1)"
    case "$result" in
      ROTATE\ *)        finding WARN "$bank/$kind.md" "over the retention target: rotate-check says $result — run /update-memory" ;;
      OVERAGE-REMAINS*) finding WARN "$bank/$kind.md" "over the retention target: $result" ;;
    esac
  done
}

# 4. EVIDENCE MARKERS ------------------------------------------------------------
# `verified: <sha> <path> [<path>...]`, one line, outside fenced code, optionally
# wrapped in parentheses. The assessment is narrow on purpose: it says whether
# the declared evidence still matches the repo, never whether the claim is true.
markers_in() {
  awk '
    BEGIN { infence = 0 }
    /^ *(```|~~~)/ { infence = !infence; next }
    infence { next }
    {
      i = index($0, "verified:")
      if (i == 0) next
      rest = substr($0, i + 9)
      p = index(rest, ")")
      if (p > 0) rest = substr(rest, 1, p - 1)
      gsub(/^[ \t]+/, "", rest); gsub(/[ \t]+$/, "", rest)
      print NR "\t" rest
    }
  ' "$1"
}

check_markers() {
  local root="$1" scope_root="$2" bank="$3" git_ok="$4" file rel lineno rest
  [ -d "$root/$bank" ] || return 0
  if [ "$git_ok" -eq 0 ]; then
    finding INCOMPLETE repo "no commits yet: evidence markers cannot be checked against HEAD"
    return 0
  fi
  local pre=""
  [ "$scope_root" != "." ] && pre="$scope_root/"
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    rel="${file#"$root"/}"
    while IFS=$'\t' read -r lineno rest; do
      [ -n "$lineno" ] || continue
      check_one_marker "$root" "$pre" "$rel" "$lineno" "$rest"
    done < <(markers_in "$file")
  done < <(find "$root/$bank" -type f -name '*.md' ! -path '*/archive/*' | sort)
}

check_one_marker() {
  local root="$1" pre="$2" rel="$3" lineno="$4" rest="$5"
  local loc="$rel:$lineno"
  local -a words resolved
  read -r -a words <<<"$rest"
  local sha="${words[0]:-}"
  if [ -z "$sha" ]; then
    finding INCOMPLETE "$loc" "marker names no evidence: expected 'verified: <sha> <path> [<path>...]'"
    return 0
  fi
  if ! git -C "$root" cat-file -e "$sha^{commit}" 2>/dev/null; then
    finding INCOMPLETE "$loc" "unknown revision $sha: the declared evidence cannot be compared"
    return 0
  fi
  if [ "${#words[@]}" -lt 2 ]; then
    finding INCOMPLETE "$loc" "marker names no evidence: $sha lists no path"
    return 0
  fi
  local p cand hit
  for p in "${words[@]:1}"; do
    hit=""
    for cand in "$pre$p" "$p"; do
      if git -C "$root" cat-file -e "HEAD:$cand" 2>/dev/null; then hit="$cand"; break; fi
    done
    if [ -z "$hit" ]; then
      finding INCOMPLETE "$loc" "evidence path missing at HEAD: $p"
      return 0
    fi
    resolved+=("$hit")
  done
  if [ -n "$(git -C "$root" status --porcelain -- "${resolved[@]}" 2>/dev/null)" ]; then
    finding INCOMPLETE "$loc" "evidence dirty in worktree: ${resolved[*]} — commit or stash before checking"
    return 0
  fi
  local changed
  changed="$(git -C "$root" diff --name-only "$sha" HEAD -- "${resolved[@]}" 2>/dev/null | tr '\n' ' ')"
  changed="${changed% }"
  if [ -n "$changed" ]; then
    finding STALE "$loc" "declared evidence differs since $sha: $changed"
  else
    n_fresh=$((n_fresh + 1))
  fi
}

# 5. UNMARKED --------------------------------------------------------------------
# Counted, never judged: a bullet without a marker is simply not assessed.
check_unmarked() {
  local root="$1" bank="$2" n
  [ -f "$root/$bank/progress.md" ] || return 0
  n="$(awk '
    BEGIN { infence = 0; insec = 0; n = 0 }
    /^ *(```|~~~)/ { infence = !infence; next }
    infence { next }
    /^## / { insec = ($0 == "## What works" || $0 == "## Recent milestones"); next }
    insec && /^- / { if (index($0, "verified:") == 0) n++ }
    END { print n + 0 }
  ' "$root/$bank/progress.md")"
  n_unmarked="$n"
  if [ "$n" -gt 0 ]; then
    finding INFO "$bank/progress.md" "$n unmarked bullets in recognized sections; semantic claims are not assessed"
  fi
}

# 6. FRAMEWORK BASELINE ----------------------------------------------------------
# Offline only: compares the framework files against the anchor ref if some
# earlier `sync-upstream` left it resolvable locally. No fetch, ever.
check_baseline() {
  local root="$1" git_ok="$2" ref base="" cand f
  [ "$git_ok" -eq 1 ] || return 0
  ref="$(jq -r 'if (.ref | type) == "string" then .ref else "" end' "$root/.serel-memory.json" 2>/dev/null || true)"
  for cand in "refs/serel-memory/anchor" "$ref"; do
    [ -n "$cand" ] || continue
    if git -C "$root" rev-parse --verify --quiet "$cand^{commit}" >/dev/null 2>&1; then base="$cand"; break; fi
  done
  if [ -z "$base" ]; then
    finding INFO repo "no local baseline${ref:+ for $ref}; run sync-upstream to compare framework files"
    return 0
  fi
  baseline_label="$base"   # name what we actually compared, not what the anchor wants
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if [ -e "$root/$f" ]; then
      finding INFO "$f" "differs from anchor baseline $baseline_label (local customization or pending sync)"
    else
      finding DRIFT "$f" "framework file missing: present in anchor baseline $baseline_label, absent here"
    fi
  done < <(git -C "$root" diff --name-only "$base" -- "${FRAMEWORK_PATHS[@]}" 2>/dev/null | sort)
}

case "${1:-}" in
  check)            shift; cmd_check "$@" ;;
  -h|--help|help|"") usage ;;
  *)                usage >&2; die "unknown subcommand '$1' (only 'check' exists)" ;;
esac
