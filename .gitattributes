# Maintainer-only material: tracked in the repo (visible on GitHub), but excluded
# from `git archive` exports — which is what `npx degit` and "Download ZIP" ship.
# Downstream projects own their docs/ folder; Serel Memory's own research and roadmap
# belong to the framework repo, not to projects scaffolded from it.
# Guarded by tests/smoke-degit.sh.
docs/research/ export-ignore

# The upstream's own provenance anchor must not leak into downstream degit
# installs — each install writes its own anchor at scaffold time.
.serel-memory.json export-ignore

# The local installer runs from a Serel Memory checkout; it is tooling, not
# part of the framework a project receives.
install.sh export-ignore

# Self-exclusion: without this, downstream degit/ZIP installs would inherit
# these export-ignore rules and exclude THEIR OWN .serel-memory.json and
# docs/research/ from any future archives they produce.
# Note: export-ignore covers archive/ZIP installs only — raw clones and forks
# still inherit the anchor (an accepted starting mode, see sync-upstream).
.gitattributes export-ignore
